# GENERATED by platform/modules/repo-onboarding (F020) for ${repository} — do not edit; `tofu apply` rewrites it.
# The repo's CI identity gets the shared preview-deployer ClusterRole, and may only write its own
# preview-${app}-* namespaces (DEC-031/050).
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: preview-deployer-${app}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: preview-deployer
subjects:
  - apiGroup: rbac.authorization.k8s.io
    kind: User
    name: ${principal}
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: preview-deployer-guard-${app}
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: ["*"]
        apiVersions: ["*"]
        operations: [CREATE, UPDATE, DELETE, CONNECT]
        resources: ["*/*"]
    excludeResourceRules:
      - apiGroups: [authorization.k8s.io, authentication.k8s.io]
        apiVersions: ["*"]
        operations: [CREATE]
        resources: ["*"]
  matchConditions:
    - name: ci-identity
      expression: request.userInfo.username == '${principal}'
  validations:
    - expression: >-
        request.resource.group == '' && request.resource.resource == 'namespaces'
        ? request.name.startsWith('preview-${app}-')
        : request.namespace.startsWith('preview-${app}-')
      messageExpression: >-
        'preview-deployer-guard-${app}: CI identity of ${repository} may only write preview-${app}-* namespaces (' +
        request.resource.resource + ' ' + request.namespace + '/' + request.name + ')'
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: preview-deployer-guard-${app}
spec:
  policyName: preview-deployer-guard-${app}
  validationActions: [Deny]
