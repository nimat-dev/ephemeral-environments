#!/usr/bin/env bash
# Fake kubectl for bootstrap tests. Logs to $KUBECTL_LOG.
#   FAKE_CTX=<current context>  FAKE_LB_IP=<ip or empty>  FAKE_ICP_PORT=<port or empty>
#   FAKE_WAIT_FAIL=1 (kubectl wait fails)  FAKE_CANI_FAIL=1 (auth can-i denies). `apply -f -` stdin is appended to $KUBECTL_LOG.apply
echo "$*" >>"${KUBECTL_LOG:?}"
case " $* " in
  *" config current-context "*) [ -n "${FAKE_CTX:-}" ] && echo "$FAKE_CTX" || exit 1 ;;
  *" get svc traefik "*) printf '%s' "${FAKE_LB_IP-}" ;;
  *" get svc keda-add-ons-http-interceptor-proxy "*) printf '%s' "${FAKE_ICP_PORT-}" ;;
  *" apply -f - "*) cat >>"$KUBECTL_LOG.apply" ;;
  *" wait "*) exit "${FAKE_WAIT_FAIL:-0}" ;;
  *" auth can-i "*) exit "${FAKE_CANI_FAIL:-0}" ;;
  *" get deploy "*)
    if [ -n "${FAKE_READY:-}" ] && [[ "$*" == *readyReplicas* ]]; then printf '%s' "$FAKE_READY"; exit 0; fi
    # FAKE_REPLICAS_SEQ: file of observed counts ("" = field absent); every read (desired or ready)
    # consumes one line, the last one repeats — state moves between polls like a real cluster.
    f="${FAKE_REPLICAS_SEQ:?}"; printf '%s' "$(head -1 "$f")"
    [ "$(wc -l <"$f")" -gt 1 ] && { tail -n +2 "$f" >"$f.tmp"; mv "$f.tmp" "$f"; }
    exit 0 ;;
  *) exit 0 ;;
esac
