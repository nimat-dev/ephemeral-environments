#!/usr/bin/env bash
# Fake az for bootstrap tests (JSON shapes mirror real az, e.g. usage numbers are strings). Logs every call to $AZ_LOG; behavior via FAKE_* env vars:
#   FAKE_EXISTS="acr aks zone"  FAKE_UNREG="Microsoft.X"  FAKE_ACCOUNT_FAIL=1  FAKE_RG_MISSING=1
#   FAKE_LIMIT=4  FAKE_RESTRICT=NotAvailableForSubscription  FAKE_NO_SKU=1  FAKE_AKS_OIDC=false
#   FAKE_FAIL="aks create"  FAKE_A_IPS="1.2.3.4"  FAKE_ROLE_COUNT=1  (FAKE_EXISTS also: uami fic app sp ghfic)  FAKE_AZURE_RBAC=true
#   FAKE_TAG_UPDATED=<lastUpdateTime of any tag on re-read before delete>
#   FAKE_TAGS_JSON=<acr show-tags --detail output>  FAKE_TAGS_FAIL=1  (delete of one tag: FAKE_FAIL="todo:<tag>")
#   FAKE_GHFIC_SUBJECT / FAKE_GHFIC_IMM_SUBJECT = stored subject of gh-preview-env / -immutable (with ghfic)
echo "$*" >>"$AZ_LOG"
args=" $* "
has() { [[ " ${FAKE_EXISTS:-} " == *" $1 "* ]]; }
if [ -n "${FAKE_FAIL:-}" ] && [[ "$args" == *" ${FAKE_FAIL} "* ]]; then echo "fake failure: $FAKE_FAIL" >&2; exit 1; fi
case "$args" in
  *" account show "*) exit "${FAKE_ACCOUNT_FAIL:-0}" ;;
  *" group show "*) [ -z "${FAKE_RG_MISSING:-}" ] ;;
  *" provider show "*)
    n=$(sed -E 's/.* -n ([^ ]+).*/\1/' <<<"$*")
    [[ " ${FAKE_UNREG:-} " == *" $n "* ]] && echo NotRegistered || echo Registered ;;
  *" vm list-skus "*)
    [ -n "${FAKE_NO_SKU:-}" ] && { echo '[]'; exit 0; }
    size=$(sed -E 's/.* --size ([^ ]+).*/\1/' <<<"$*")
    r='[]'; [ -n "${FAKE_RESTRICT:-}" ] && r="[{\"reasonCode\":\"$FAKE_RESTRICT\"}]"
    echo "[{\"name\":\"$size\",\"family\":\"FamX\",\"restrictions\":$r,\"capabilities\":[{\"name\":\"vCPUs\",\"value\":\"2\"}]}]" ;;
  *" vm list-usage "*)
    l=${FAKE_LIMIT:-4}
    echo "[{\"name\":{\"value\":\"FamX\"},\"currentValue\":\"0\",\"limit\":\"$l\"},{\"name\":{\"value\":\"cores\"},\"currentValue\":\"0\",\"limit\":\"$l\"}]" ;;
  *" record-set a show "*) [ -n "${FAKE_A_IPS:-}" ] || exit 3; tr ' ' '\n' <<<"$FAKE_A_IPS" ;;
  *" identity federated-credential show "*) has fic ;;
  *" identity show "*)
    has uami || exit 3
    [[ "$args" == *" clientId "* ]] && echo cid-123
    [[ "$args" == *" principalId "* ]] && echo pid-456
    exit 0 ;;
  *" role assignment list "*) echo "${FAKE_ROLE_COUNT:-0}" ;;
  *" acr show "*" --query id "*) echo /acr-id ;;
  *" acr show "*) has acr ;;
  *" aks show "*" --query id "*) echo /aks-id ;;
  *" aks show "*"enableAzureRbac"*) echo "${FAKE_AZURE_RBAC:-}" ;;
  *" ad signed-in-user show "*) echo me-oid ;;
  *" acr repository show "*) echo "${FAKE_TAG_UPDATED:-2000-01-01T00:00:00.1234567Z}" ;;
  *" acr repository show-tags "*) [ -n "${FAKE_TAGS_FAIL:-}" ] && exit 1; printf '%s' "${FAKE_TAGS_JSON:-[]}" ;;
  *" ad app federated-credential list "*)
    has ghfic || exit 0
    if [[ "$args" == *gh-preview-env-immutable* ]]; then echo "${FAKE_GHFIC_IMM_SUBJECT:-}"
    else echo "${FAKE_GHFIC_SUBJECT:-repo:nimat-dev/ephemeral-environments:environment:preview}"; fi ;;
  *" ad app list "*) has app && echo app-123 || true ;;
  *" ad sp show "*) has sp && echo sp-oid || exit 3 ;;
  *" aks show "*)
    has aks || exit 3
    o=${FAKE_AKS_OIDC:-true}
    echo "{\"oidcIssuerProfile\":{\"enabled\":$o},\"securityProfile\":{\"workloadIdentity\":{\"enabled\":$o}}}" ;;
  *" dns zone show "*)
    has zone || exit 3
    [[ "$args" == *" nameServers "* ]] && printf 'ns1-01.azure-dns.com.\nns2-01.azure-dns.net.\n'
    [[ "$args" == *" --query id "* ]] && echo /subscriptions/sub-1/zone
    exit 0 ;;
  *) exit 0 ;;   # create / update / delete / register / get-credentials
esac
