#!/usr/bin/env bash
# Fake gh: logs to $GH_LOG. FAKE_GH_ADMIN=true|false (repo admin permission).
# FAKE_GH_SUB_PREFIX=<oidc sub_claim_prefix> (empty = legacy/unknown).
echo "$*" >>"${GH_LOG:?}"
case " $* " in
  *" .permissions.admin "*) echo "${FAKE_GH_ADMIN:-false}" ;;
  *" api user "*) echo fake-user ;;
  *"/actions/oidc/customization/sub "*) echo "${FAKE_GH_SUB_PREFIX-}" ;;
  *) exit 0 ;;
esac
